  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "social-media",
    "scheduler",
    "publishing",
    "sqlite",
    "typescript"
  ],
  "license": "GPL-3.0",
  "main": "dist/src/index.js",
  "name": "@tytechlabs/social-automation",
  "scripts": {
